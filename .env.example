# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# ---------- Checkout (URL do checkout JÁ EXISTENTE; sem ela o botão fica desativado) ----------
NEXT_PUBLIC_CHECKOUT_URL=

# ---------- Oferta ----------
# Preço atual em reais (use ponto). Teste: 19.90. Campanha de lançamento: 9.90
NEXT_PUBLIC_PRICE=19.90
# Preço de referência: preencha SOMENTE se ele for real (já praticado) e comprovável. Vazio = não exibe.
NEXT_PUBLIC_REFERENCE_PRICE=
# Rótulo opcional da campanha (ex.: "Preço de lançamento"). Vazio = não exibe.
NEXT_PUBLIC_PRICE_LABEL=

# ---------- Itens efetivamente disponíveis (só o que existe aparece na página) ----------
# Valores aceitos, separados por vírgula: modules,workshops,handout,printables,quiz,certificate
NEXT_PUBLIC_READY_ITEMS=
# Texto sobre quando as aulas estarão disponíveis (resposta do FAQ). Vazio = texto neutro padrão.
NEXT_PUBLIC_AVAILABILITY_TEXT=
# Política de reembolso REAL (texto curto). Vazio = bloco não é exibido.
NEXT_PUBLIC_REFUND_POLICY=

# ---------- Dados reais da empresa (rodapé / termos / privacidade) ----------
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_CNPJ=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=

# ---------- Imagem real do hero (opcional; arquivo em /public/media) ----------
NEXT_PUBLIC_HERO_IMAGE=
NEXT_PUBLIC_HERO_IMAGE_ALT=

# ---------- Analytics (carregados só após consentimento) ----------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Backend (NUNCA com prefixo NEXT_PUBLIC_) ----------
# Segredo compartilhado com o checkout para assinar o webhook (HMAC-SHA256)
CHECKOUT_WEBHOOK_SECRET=
# Sal para anonimizar IDs de pedido (string aleatória longa)
PURCHASE_HASH_SALT=
